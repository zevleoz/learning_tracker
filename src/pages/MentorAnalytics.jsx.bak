function StudentOverviewCard({ student, sessions }) {
  const stats = useMemo(() => {
    const totalMins = sessions.reduce((a, s) => a + (s.duration_minutes || 0), 0);
    let scoreSum = 0;
    let scoreCount = 0;
    let selfMins = 0;
    let externalMins = 0;
    let studyMins = 0;
    let reviewMins = 0;
    let practiceMins = 0;
    
    for (const s of sessions) {
      if (Number(s.eval_type) === 2 && s.score != null && s.score !== '') {
        scoreSum += Number(s.score);
        scoreCount++;
      }
      const mins = s.duration_minutes || 0;
      if (s.form === '自主学习' || s.form === '自主复习' || s.form === '自主练习') {
        selfMins += mins;
      } else {
        externalMins += mins;
      }
      if (s.category === 1) studyMins += mins;
      else if (s.category === 2) reviewMins += mins;
      else if (s.category === 3) practiceMins += mins;
    }
    
    const avgScore = scoreCount > 0 ? scoreSum / scoreCount : 0;
    const selfRate = totalMins > 0 ? (selfMins / totalMins) * 100 : 0;
    const avgDuration = sessions.length > 0 ? Math.round(totalMins / sessions.length) : 0;
    
    return { 
      totalMins, 
      avgScore: Math.round(avgScore), 
      sessionCount: sessions.length, 
      selfRate: Math.round(selfRate),
      avgDuration,
      studyMins,
      reviewMins,
      practiceMins,
    };
  }, [sessions]);

  const statItems = [
    { label: '学习记录', value: stats.sessionCount, color: '#6366f1' },
    { label: '累计时长', value: fmtMinutes(stats.totalMins), color: '#8b5cf6' },
    { label: '平均分数', value: stats.avgScore, color: stats.avgScore >= 80 ? '#10b981' : stats.avgScore >= 60 ? '#f59e0b' : '#ef4444' },
    { label: '自主学习率', value: `${stats.selfRate}%`, color: stats.selfRate >= 60 ? '#3b82f6' : '#f59e0b' },
    { label: '学习时长', value: fmtMinutes(stats.studyMins), color: '#6366f1' },
    { label: '练习时长', value: fmtMinutes(stats.practiceMins), color: '#ec4899' },
  ];

  return (
    <div className="mentor-analytics-overview">
      <div className="mentor-analytics-student-info">
        <div className="mentor-analytics-student-avatar">{student.full_name?.charAt(0) || 'S'}</div>
        <div>
          <div className="mentor-analytics-student-name">{student.full_name || '演示学生'}</div>
          <div className="mentor-analytics-student-school">{student.school_name || '示例学校'}</div>
        </div>
      </div>
      <div className="mentor-analytics-overview-grid">
        {statItems.map((item, index) => (
          <div key={index} className="mentor-analytics-overview-stat-item">
            <div className="mentor-analytics-overview-stat-value" style={{ color: item.color }}>
              {item.value}
            </div>
            <div className="mentor-analytics-overview-stat-label">{item.label}</div>
          </div>
        ))}
      </div>
    </div>
  );
}

function SubjectRadarChart({ sessions }) {
  const subjectData = useMemo(() => {
    const bySubj = {};
    for (const s of sessions) {
      const subj = s.subject || '未分类';
      bySubj[subj] = bySubj[subj] || { mins: 0, scoreSum: 0, scoreCount: 0 };
      bySubj[subj].mins += s.duration_minutes || 0;
      if (Number(s.eval_type) === 2 && s.score != null && s.score !== '') {
        bySubj[subj].scoreSum += Number(s.score);
        bySubj[subj].scoreCount++;
      }
    }
    
    const subjects = Object.entries(bySubj).map(([name, data]) => ({
      name,
      duration: data.mins,
      avgScore: data.scoreCount > 0 ? Math.round(data.scoreSum / data.scoreCount) : 0,
    }));
    
    const maxMins = Math.max(...subjects.map(s => s.duration), 1);
    
    return subjects.map(s => ({
      ...s,
      durationScore: Math.min(100, (s.duration / maxMins) * 100),
    }));
  }, [sessions]);

  if (subjectData.length === 0) {
    return (
      <div className="mentor-analytics-panel">
        <div className="mentor-analytics-panel-header">
          <h3 className="mentor-analytics-panel-title">科目能力雷达图</h3>
        </div>
        <div className="mentor-empty-state">暂无数据</div>
      </div>
    );
  }

  const center = 220;
  const radius = 180;
  const angleStep = (Math.PI * 2) / subjectData.length;

  const getPoint = (value, index) => {
    const angle = index * angleStep - Math.PI / 2;
    const r = (value / 100) * radius;
    return { x: center + r * Math.cos(angle), y: center + r * Math.sin(angle) };
  };

  const scorePath = subjectData.map((s, i) => getPoint(s.avgScore, i))
    .map((p, i) => (i === 0 ? `M ${p.x} ${p.y}` : `L ${p.x} ${p.y}`))
    .join(' ') + ' Z';

  const durationPath = subjectData.map((s, i) => getPoint(s.durationScore, i))
    .map((p, i) => (i === 0 ? `M ${p.x} ${p.y}` : `L ${p.x} ${p.y}`))
    .join(' ') + ' Z';

  return (
    <div className="mentor-analytics-panel mentor-analytics-panel-radar">
      <div className="mentor-analytics-panel-header">
        <h3 className="mentor-analytics-panel-title">科目能力雷达图</h3>
        <span className="mentor-analytics-panel-subtitle">{subjectData.length} 个科目</span>
      </div>
      <div className="mentor-analytics-radar-wrapper">
        <svg viewBox="0 0 500 500" className="mentor-analytics-radar-svg" preserveAspectRatio="xMidYMid meet">
          {[20, 40, 60, 80, 100].map((level) => (
            <circle
              key={level}
              cx={center}
              cy={center}
              r={(level / 100) * radius}
              fill="none"
              stroke="#e2e8f0"
              strokeWidth="1"
            />
          ))}
          {[20, 40, 60, 80, 100].map((level) => (
            <text
              key={`label-${level}`}
              x={center + 8}
              y={center - (level / 100) * radius}
              textAnchor="start"
              dominantBaseline="middle"
              fontSize="9"
              fill="#94a3b8"
            >
              {level}
            </text>
          ))}
          {subjectData.map((_, i) => {
            const angle = i * angleStep - Math.PI / 2;
            return (
              <line
                key={i}
                x1={center}
                y1={center}
                x2={center + radius * Math.cos(angle)}
                y2={center + radius * Math.sin(angle)}
                stroke="#e2e8f0"
                strokeWidth="1"
              />
            );
          })}
          <path
            d={durationPath}
            fill="rgba(99, 102, 241, 0.15)"
            stroke="#6366f1"
            strokeWidth="2.5"
          />
          <path
            d={scorePath}
            fill="rgba(16, 185, 129, 0.15)"
            stroke="#10b981"
            strokeWidth="2.5"
          />
          {subjectData.map((s, i) => {
            const angle = i * angleStep - Math.PI / 2;
            const labelRadius = radius + 35;
            const scorePoint = getPoint(s.avgScore, i);
            const durationPoint = getPoint(s.durationScore, i);
            return (
              <g key={i}>
                <g>
                  <rect
                    x={center + labelRadius * Math.cos(angle) - 25}
                    y={center + labelRadius * Math.sin(angle) - 10}
                    width="50"
                    height="20"
                    rx="8"
                    fill="rgba(99, 102, 241, 0.1)"
                    stroke="#6366f1"
                    strokeWidth="1"
                  />
                  <text
                    x={center + labelRadius * Math.cos(angle)}
                    y={center + labelRadius * Math.sin(angle)}
                    textAnchor="middle"
                    dominantBaseline="middle"
                    fontSize="12"
                    fill="#334155"
                    fontWeight={600}
                  >
                    {s.name}
                  </text>
                </g>
                <circle
                  cx={scorePoint.x}
                  cy={scorePoint.y}
                  r="5"
                  fill="#10b981"
                />
                <circle
                  cx={scorePoint.x}
                  cy={scorePoint.y}
                  r="2"
                  fill="white"
                />
                <circle
                  cx={durationPoint.x}
                  cy={durationPoint.y}
                  r="5"
                  fill="#6366f1"
                />
                <circle
                  cx={durationPoint.x}
                  cy={durationPoint.y}
                  r="2"
                  fill="white"
                />
              </g>
            );
          })}
        </svg>
        <div className="mentor-analytics-radar-legend">
          <div className="mentor-analytics-radar-legend-item">
            <div className="mentor-analytics-radar-legend-color" style={{ background: '#6366f1', borderRadius: '50%' }} />
            <span>学习时长</span>
          </div>
          <div className="mentor-analytics-radar-legend-item">
            <div className="mentor-analytics-radar-legend-color" style={{ background: '#10b981', borderRadius: '50%' }} />
            <span>分数表现</span>
          </div>
        </div>
        <div className="mentor-analytics-radar-data">
          {subjectData.map((s, i) => (
            <div key={i} className="mentor-analytics-radar-data-item">
              <span className="mentor-analytics-radar-data-name">{s.name}</span>
              <span className="mentor-analytics-radar-data-duration" style={{ color: '#6366f1' }}>{fmtMinutes(s.duration)}</span>
              <span className="mentor-analytics-radar-data-score" style={{ color: s.avgScore >= 80 ? '#10b981' : s.avgScore >= 60 ? '#f59e0b' : '#ef4444' }}>{s.avgScore}分</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

function SubjectComparisonMatrix({ sessions }) {
  const [sortField, setSortField] = useState('duration');
  const [sortDir, setSortDir] = useState('desc');

  const subjectData = useMemo(() => {
    const bySubj = {};
    for (const s of sessions) {
      const subj = s.subject || '未分类';
      bySubj[subj] = bySubj[subj] || { 
        mins: 0, scoreSum: 0, scoreCount: 0, selfMins: 0,
        studyCount: 0, reviewCount: 0, practiceCount: 0 
      };
      bySubj[subj].mins += s.duration_minutes || 0;
      if (Number(s.eval_type) === 2 && s.score != null && s.score !== '') {
        bySubj[subj].scoreSum += Number(s.score);
        bySubj[subj].scoreCount++;
      }
      if (s.form === '自主学习' || s.form === '自主复习' || s.form === '自主练习') {
        bySubj[subj].selfMins += s.duration_minutes || 0;
      }
      if (s.category === 1) bySubj[subj].studyCount++;
      else if (s.category === 2) bySubj[subj].reviewCount++;
      else if (s.category === 3) bySubj[subj].practiceCount++;
    }
    
    return Object.entries(bySubj).map(([name, data]) => ({
      name,
      duration: data.mins,
      avgScore: data.scoreCount > 0 ? Math.round(data.scoreSum / data.scoreCount) : 0,
      selfRate: data.mins > 0 ? Math.round((data.selfMins / data.mins) * 100) : 0,
      studyCount: data.studyCount,
      reviewCount: data.reviewCount,
      practiceCount: data.practiceCount,
    })).sort((a, b) => {
      const valA = a[sortField];
      const valB = b[sortField];
      if (sortDir === 'asc') return valA - valB;
      return valB - valA;
    });
  }, [sessions, sortField, sortDir]);

  const handleSort = (field) => {
    if (sortField === field) {
      setSortDir(sortDir === 'asc' ? 'desc' : 'asc');
    } else {
      setSortField(field);
      setSortDir('desc');
    }
  };

  const avgScore = subjectData.length > 0 
    ? Math.round(subjectData.reduce((a, s) => a + s.avgScore, 0) / subjectData.length) 
    : 0;

  const totalDuration = subjectData.reduce((a, s) => a + s.duration, 0);

  return (
    <div className="mentor-analytics-panel mentor-analytics-panel-matrix">
      <div className="mentor-analytics-panel-header">
        <h3 className="mentor-analytics-panel-title">科目对比矩阵</h3>
        <span className="mentor-analytics-panel-subtitle">共 {subjectData.length} 个科目，总计 {fmtMinutes(totalDuration)}</span>
      </div>
      <div className="mentor-analytics-matrix-wrapper">
        <table className="mentor-analytics-matrix-table">
          <thead>
            <tr>
              <th onClick={() => handleSort('name')} className={`mentor-analytics-matrix-th ${sortField === 'name' ? 'mentor-analytics-matrix-th-sorted' : ''}`}>
                科目名称 {sortField === 'name' && (sortDir === 'asc' ? '↑' : '↓')}
              </th>
              <th onClick={() => handleSort('duration')} className={`mentor-analytics-matrix-th ${sortField === 'duration' ? 'mentor-analytics-matrix-th-sorted' : ''}`}>
                学习时长 {sortField === 'duration' && (sortDir === 'asc' ? '↑' : '↓')}
              </th>
              <th>时长占比</th>
              <th onClick={() => handleSort('avgScore')} className={`mentor-analytics-matrix-th ${sortField === 'avgScore' ? 'mentor-analytics-matrix-th-sorted' : ''}`}>
                平均分数 {sortField === 'avgScore' && (sortDir === 'asc' ? '↑' : '↓')}
              </th>
              <th>分数等级</th>
              <th onClick={() => handleSort('selfRate')} className={`mentor-analytics-matrix-th ${sortField === 'selfRate' ? 'mentor-analytics-matrix-th-sorted' : ''}`}>
                自主学习率 {sortField === 'selfRate' && (sortDir === 'asc' ? '↑' : '↓')}
              </th>
              <th>学习状态</th>
            </tr>
          </thead>
          <tbody>
            {subjectData.map((subj) => {
              const scoreColor = subj.avgScore >= 80 ? '#10b981' : subj.avgScore >= 60 ? '#f59e0b' : '#ef4444';
              const durationPct = totalDuration > 0 ? Math.round((subj.duration / totalDuration) * 100) : 0;
              const isExcellent = subj.avgScore >= avgScore + 5 && subj.duration > 0;
              const isWeak = subj.avgScore < avgScore - 10;
              
              return (
                <tr key={subj.name} className="mentor-analytics-matrix-row">
                  <td className="mentor-analytics-matrix-subject">
                    <div className="mentor-analytics-matrix-subject-name">{subj.name}</div>
                    <div className="mentor-analytics-matrix-subject-detail">
                      {subj.scoreCount} 次评分 · 学{subj.studyCount || 0}次 · 复{subj.reviewCount || 0}次 · 练{subj.practiceCount || 0}次
                    </div>
                  </td>
                  <td className="mentor-analytics-matrix-duration">{fmtMinutes(subj.duration)}</td>
                  <td className="mentor-analytics-matrix-bar-cell">
                    <div className="mentor-analytics-matrix-bar-bg">
                      <div 
                        className="mentor-analytics-matrix-bar-fill" 
                        style={{ width: `${durationPct}%`, background: '#6366f1' }} 
                      />
                    </div>
                    <span className="mentor-analytics-matrix-bar-pct">{durationPct}%</span>
                  </td>
                  <td className="mentor-analytics-matrix-score" style={{ color: scoreColor }}>
                    {subj.avgScore}
                  </td>
                  <td className="mentor-analytics-matrix-level">
                    {subj.avgScore >= 90 ? 'A' : subj.avgScore >= 80 ? 'B' : subj.avgScore >= 70 ? 'C' : subj.avgScore >= 60 ? 'D' : 'F'}
                  </td>
                  <td className="mentor-analytics-matrix-self">
                    <div className="mentor-analytics-matrix-self-bar">
                      <div 
                        className="mentor-analytics-matrix-self-fill" 
                        style={{ width: `${subj.selfRate}%`, background: subj.selfRate >= 60 ? '#10b981' : '#f59e0b' }} 
                      />
                    </div>
                    <span>{subj.selfRate}%</span>
                  </td>
                  <td className="mentor-analytics-matrix-status">
                    {isExcellent && (
                      <span className="mentor-analytics-status-badge mentor-analytics-status-excellent">优秀</span>
                    )}
                    {isWeak && !isExcellent && (
                      <span className="mentor-analytics-status-badge mentor-analytics-status-weak">薄弱</span>
                    )}
                    {!isExcellent && !isWeak && (
                      <span className="mentor-analytics-status-badge mentor-analytics-status-normal">一般</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  );
}

function LearningBehaviorAnalysis({ sessions }) {
  const behaviorData = useMemo(() => {
    let totalMins = 0;
    let selfMins = 0;
    let reviewMins = 0;
    let practiceMins = 0;
    let externalMins = 0;
    let studyMins = 0;
    let avgSessionMins = 0;
    
    for (const s of sessions) {
      const mins = s.duration_minutes || 0;
      totalMins += mins;
      
      if (s.form === '自主学习' || s.form === '自主复习' || s.form === '自主练习') {
        selfMins += mins;
      } else {
        externalMins += mins;
      }
      
      if (s.category === 1) studyMins += mins;
      else if (s.category === 2) reviewMins += mins;
      else if (s.category === 3) practiceMins += mins;
    }
    
    const selfRate = totalMins > 0 ? Math.round((selfMins / totalMins) * 100) : 0;
    avgSessionMins = sessions.length > 0 ? Math.round(totalMins / sessions.length) : 0;
    
    return {
      studyMins,
      reviewMins,
      practiceMins,
      selfMins,
      externalMins,
      selfRate,
      totalMins,
      avgSessionMins,
      sessionCount: sessions.length,
    };
  }, [sessions]);

  const studyPct = behaviorData.totalMins > 0 ? Math.round((behaviorData.studyMins / behaviorData.totalMins) * 100) : 0;
  const reviewPct = behaviorData.totalMins > 0 ? Math.round((behaviorData.reviewMins / behaviorData.totalMins) * 100) : 0;
  const practicePct = behaviorData.totalMins > 0 ? Math.round((behaviorData.practiceMins / behaviorData.totalMins) * 100) : 0;

  return (
    <div className="mentor-analytics-panel mentor-analytics-panel-behavior">
      <div className="mentor-analytics-panel-header">
        <h3 className="mentor-analytics-panel-title">学习行为分析</h3>
        <span className="mentor-analytics-panel-subtitle">共 {behaviorData.sessionCount} 次学习记录，总计 {fmtMinutes(behaviorData.totalMins)}</span>
      </div>
      <div className="mentor-analytics-behavior-content">
        <div className="mentor-analytics-behavior-section">
          <div className="mentor-analytics-behavior-title">学习类型分配</div>
          <div className="mentor-analytics-behavior-bars">
            <div className="mentor-analytics-behavior-bar-item">
              <div className="mentor-analytics-behavior-bar-header">
                <span className="mentor-analytics-behavior-bar-label">学习</span>
                <div>
                  <span className="mentor-analytics-behavior-bar-value">{fmtMinutes(behaviorData.studyMins)}</span>
                  <span className="mentor-analytics-behavior-bar-pct">{studyPct}%</span>
                </div>
              </div>
              <div className="mentor-analytics-behavior-bar-track">
                <div 
                  className="mentor-analytics-behavior-bar-fill" 
                  style={{ 
