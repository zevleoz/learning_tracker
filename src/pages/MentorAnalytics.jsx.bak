import { useEffect, useMemo, useState } from 'react';
import { supabase } from '../lib/supabase.js';

function fmtMinutes(mins) {
  if (!mins) return '0m';
  if (mins < 60) return mins + 'm';
  const h = Math.floor(mins / 60);
  const m = mins % 60;
  return m ? `${h}h ${m}m` : `${h}h`;
}

function generateFakeSessions() {
  const today = new Date();
  const sessions = [];
  
  const sessionData = [
    { subject: '数学', category: 1, form: '自主学习', eval_type: 2, score: 85, duration: 45, daysAgo: 30 },
    { subject: '数学', category: 2, form: '自主复习', eval_type: 1, score: null, duration: 30, daysAgo: 29 },
    { subject: '数学', category: 3, form: '自主练习', eval_type: 2, score: 88, duration: 40, daysAgo: 28 },
    { subject: '数学', category: 1, form: '自主学习', eval_type: 2, score: 82, duration: 50, daysAgo: 25 },
    { subject: '数学', category: 3, form: '自主练习', eval_type: 2, score: 90, duration: 45, daysAgo: 22 },
    { subject: '英语', category: 1, form: '校外线下', eval_type: 2, score: 72, duration: 60, daysAgo: 30 },
    { subject: '英语', category: 3, form: '自主练习', eval_type: 2, score: 75, duration: 35, daysAgo: 28 },
    { subject: '英语', category: 1, form: '校外线下', eval_type: 2, score: 70, duration: 60, daysAgo: 25 },
    { subject: '英语', category: 3, form: '自主练习', eval_type: 2, score: 73, duration: 40, daysAgo: 23 },
    { subject: '英语', category: 2, form: '自主复习', eval_type: 1, score: null, duration: 25, daysAgo: 20 },
    { subject: '物理', category: 1, form: '校外线上', eval_type: 2, score: 62, duration: 60, daysAgo: 30 },
    { subject: '物理', category: 3, form: '自主练习', eval_type: 2, score: 65, duration: 45, daysAgo: 28 },
    { subject: '物理', category: 1, form: '自主学习', eval_type: 2, score: 60, duration: 50, daysAgo: 25 },
    { subject: '物理', category: 3, form: '自主练习', eval_type: 2, score: 68, duration: 50, daysAgo: 22 },
    { subject: '物理', category: 2, form: '自主复习', eval_type: 1, score: null, duration: 30, daysAgo: 20 },
    { subject: '化学', category: 1, form: '自主学习', eval_type: 2, score: 78, duration: 40, daysAgo: 30 },
    { subject: '化学', category: 3, form: '自主练习', eval_type: 2, score: 80, duration: 35, daysAgo: 28 },
    { subject: '化学', category: 1, form: '自主学习', eval_type: 2, score: 76, duration: 45, daysAgo: 25 },
    { subject: '化学', category: 3, form: '自主练习', eval_type: 2, score: 82, duration: 40, daysAgo: 23 },
    { subject: '历史', category: 1, form: '自主学习', eval_type: 2, score: 88, duration: 30, daysAgo: 30 },
    { subject: '历史', category: 2, form: '自主复习', eval_type: 1, score: null, duration: 35, daysAgo: 28 },
    { subject: '历史', category: 1, form: '自主学习', eval_type: 2, score: 85, duration: 35, daysAgo: 25 },
    { subject: '历史', category: 2, form: '自主复习', eval_type: 1, score: null, duration: 40, daysAgo: 22 },
    { subject: '语文', category: 1, form: '自主学习', eval_type: 2, score: 80, duration: 35, daysAgo: 29 },
    { subject: '语文', category: 3, form: '自主练习', eval_type: 2, score: 82, duration: 30, daysAgo: 26 },
    { subject: '语文', category: 1, form: '自主学习', eval_type: 2, score: 78, duration: 40, daysAgo: 23 },
    { subject: '语文', category: 2, form: '自主复习', eval_type: 1, score: null, duration: 25, daysAgo: 20 },
  ];
  
  sessionData.forEach((s) => {
    const sessionDate = new Date(today);
    sessionDate.setDate(today.getDate() - s.daysAgo);
    sessions.push({
      id: Math.random().toString(36).substr(2, 9),
