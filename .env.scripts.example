# scripts/ 运维脚本凭据模板：复制为 .env.scripts 并填入真实值（.env.scripts 已被 .gitignore 忽略）
# Supabase 项目
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key，仅少量数据脚本需要>

# 脚本操作的目标账号密码（脚本里的邮箱保留在代码中，密码一律来自这里）
SCRIPT_ADMIN_PASSWORD=<admin@yibc.com 的密码>
SCRIPT_MENTOR_PASSWORD=<导师/教师测试账号的密码>
SCRIPT_TEST_PASSWORD=<学生测试账号的密码>