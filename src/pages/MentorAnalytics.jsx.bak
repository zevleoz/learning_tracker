            <span className="mentor-analytics-behavior-stat-label-compact">自主率</span>
          </div>
        </div>
      </div>
    </div>
  );
}

function ScoreTrendChart({ sessions }) {
  const scoreData = useMemo(() => {
    const byDate = {};
    for (const s of sessions) {
      if (Number(s.eval_type) === 2 && s.score != null && s.score !== '') {
        const date = s.date;
        byDate[date] = byDate[date] || [];
        byDate[date].push(Number(s.score));
      }
    }
    return Object.entries(byDate)
      .map(([date, scores]) => ({
        date,
        avgScore: Math.round(scores.reduce((a, b) => a + b, 0) / scores.length),
        count: scores.length,
      }))
      .sort((a, b) => new Date(a.date) - new Date(b.date));
  }, [sessions]);

  const trendLine = useMemo(() => {
    if (scoreData.length < 2) return null;
    const n = scoreData.length;
    const sumX = scoreData.reduce((sum, _, i) => sum + i, 0);
    const sumY = scoreData.reduce((sum, s) => sum + s.avgScore, 0);
    const sumXY = scoreData.reduce((sum, s, i) => sum + i * s.avgScore, 0);
    const sumX2 = scoreData.reduce((sum, _, i) => sum + i * i, 0);
    
    const slope = (n * sumXY - sumX * sumY) / (n * sumX2 - sumX * sumX);
    const intercept = (sumY - slope * sumX) / n;
    
    return { slope, intercept };
  }, [scoreData]);

  if (scoreData.length === 0) {
    return (
      <div className="mentor-analytics-panel mentor-analytics-panel-full">
        <div className="mentor-analytics-panel-header">
          <h3 className="mentor-analytics-panel-title">分数趋势</h3>
        </div>
        <div className="mentor-empty-state">暂无分数数据</div>
      </div>
    );
  }

  const maxScore = 100;
  const minScore = Math.max(0, Math.min(...scoreData.map(s => s.avgScore)) - 10);
  const padding = 50;
  const height = 240;
  const width = 1200;
  const chartWidth = width - padding * 2;
  const chartHeight = height - padding * 2;

  return (
    <div className="mentor-analytics-panel mentor-analytics-panel-full mentor-analytics-panel-trend">
      <div className="mentor-analytics-panel-header">
        <h3 className="mentor-analytics-panel-title">分数趋势</h3>
        <span className="mentor-analytics-panel-subtitle">最近 {scoreData.length} 次评分记录</span>
      </div>
      <div className="mentor-analytics-trend-wrapper">
        <svg viewBox={`0 0 ${width} ${height}`} className="mentor-analytics-trend-svg" preserveAspectRatio="xMidYMid meet">
          <defs>
            <linearGradient id="scoreAreaGradient" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stopColor="#6366f1" stopOpacity="0.25" />
              <stop offset="100%" stopColor="#6366f1" stopOpacity="0" />
            </linearGradient>
          </defs>
          {[0, 20, 40, 60, 80, 100].map(score => {
            const y = padding + chartHeight - ((score - minScore) / (maxScore - minScore)) * chartHeight;
            return (
              <g key={score}>
                <line
                  x1={padding}
                  y1={y}
                  x2={width - padding}
                  y2={y}
                  stroke={score === 60 ? '#f59e0b' : score === 80 ? '#10b981' : '#e2e8f0'}
                  strokeDasharray={score === 60 || score === 80 ? '6 4' : 'none'}
                  strokeWidth={score === 60 || score === 80 ? 1.5 : 1}
                />
                <text
                  x={padding - 12}
                  y={y + 4}
                  textAnchor="end"
                  fontSize="11"
                  fill="#64748b"
                  fontWeight={500}
                >
                  {score}
                </text>
              </g>
            );
          })}
          <path
            d={`M ${scoreData.map((s, i) => {
              const x = padding + (i / (scoreData.length - 1)) * chartWidth;
              const y = padding + chartHeight - ((s.avgScore - minScore) / (maxScore - minScore)) * chartHeight;
              return `${x} ${y}`;
            }).join(' L ')} L ${padding + chartWidth} ${height - padding} L ${padding} ${height - padding} Z`}
            fill="url(#scoreAreaGradient)"
          />
          <path
            d={`M ${scoreData.map((s, i) => {
              const x = padding + (i / (scoreData.length - 1)) * chartWidth;
              const y = padding + chartHeight - ((s.avgScore - minScore) / (maxScore - minScore)) * chartHeight;
              return `${x} ${y}`;
            }).join(' L ')}`}
            fill="none"
            stroke="#6366f1"
            strokeWidth="3"
            strokeLinecap="round"
            strokeLinejoin="round"
          />
          {trendLine && (
            <line
              x1={padding}
              y1={padding + chartHeight - ((trendLine.intercept - minScore) / (maxScore - minScore)) * chartHeight}
              x2={width - padding}
              y2={padding + chartHeight - ((trendLine.intercept + trendLine.slope * (scoreData.length - 1) - minScore) / (maxScore - minScore)) * chartHeight}
              stroke="#f59e0b"
              strokeWidth="2"
              strokeDasharray="8 4"
              strokeLinecap="round"
            />
          )}
          {scoreData.map((s, i) => {
            const x = padding + (i / (scoreData.length - 1)) * chartWidth;
            const y = padding + chartHeight - ((s.avgScore - minScore) / (maxScore - minScore)) * chartHeight;
            const pointColor = s.avgScore >= 80 ? '#10b981' : s.avgScore >= 60 ? '#f59e0b' : '#ef4444';
            return (
              <g key={s.date}>
                <circle cx={x} cy={y} r="7" fill={pointColor} />
                <circle cx={x} cy={y} r="3" fill="white" />
                <text x={x} y={height - 12} textAnchor="middle" fontSize="10" fill="#64748b">
                  {s.date.slice(5)}
                </text>
                <text x={x} y={y - 14} textAnchor="middle" fontSize="11" fill="#334155" fontWeight={600}>
                  {s.avgScore}
                </text>
              </g>
            );
          })}
        </svg>
      </div>
    </div>
  );
}

function LearningHeatmap({ sessions }) {
  const heatmapData = useMemo(() => {
    const today = new Date();
    const data = {};
    
    for (let i = 0; i < 42; i++) {
      const date = new Date(today);
      date.setDate(today.getDate() - i);
      const dateStr = date.toISOString().split('T')[0];
      data[dateStr] = { mins: 0, sessions: [] };
    }
    
    for (const s of sessions) {
      const dateStr = s.date || s.session_date;
      if (data[dateStr] !== undefined) {
        data[dateStr].mins += s.duration_minutes || 0;
        data[dateStr].sessions.push(s);
      }
    }
    
    const weeks = [];
    let currentWeek = [];
    
    Object.entries(data).reverse().forEach(([date, info], index) => {
      currentWeek.push({ date, ...info });
      if (currentWeek.length === 7 || index === Object.keys(data).length - 1) {
        weeks.push(currentWeek);
        currentWeek = [];
      }
    });
    
    return weeks;
  }, [sessions]);

  const getColor = (mins) => {
    if (mins === 0) return '#f1f5f9';
    if (mins < 30) return '#dcfce7';
    if (mins < 60) return '#bbf7d0';
    if (mins < 120) return '#86efac';
    if (mins < 180) return '#4ade80';
    return '#22c55e';
  };

  const totalMins = heatmapData.flat().reduce((a, d) => a + d.mins, 0);
  const activeDays = heatmapData.flat().filter(d => d.mins > 0).length;

  return (
    <div className="mentor-analytics-panel mentor-analytics-panel-heatmap">
      <div className="mentor-analytics-panel-header">
        <h3 className="mentor-analytics-panel-title">学习投入热力图</h3>
        <span className="mentor-analytics-panel-subtitle">最近6周</span>
      </div>
      <div className="mentor-analytics-heatmap-summary">
        <div className="mentor-analytics-heatmap-summary-item">
          <div className="mentor-analytics-heatmap-summary-value">{fmtMinutes(totalMins)}</div>
          <div className="mentor-analytics-heatmap-summary-label">总学习时长</div>
        </div>
        <div className="mentor-analytics-heatmap-summary-divider" />
        <div className="mentor-analytics-heatmap-summary-item">
          <div className="mentor-analytics-heatmap-summary-value">{activeDays}</div>
          <div className="mentor-analytics-heatmap-summary-label">活跃天数</div>
        </div>
      </div>
      <div className="mentor-analytics-heatmap-wrapper">
        <div className="mentor-analytics-heatmap-weekdays">
          <span className="mentor-analytics-heatmap-weekday">一</span>
          <span className="mentor-analytics-heatmap-weekday">三</span>
          <span className="mentor-analytics-heatmap-weekday">五</span>
        </div>
        <div className="mentor-analytics-heatmap-grid">
          {heatmapData.map((week, weekIndex) => (
            <div key={weekIndex} className="mentor-analytics-heatmap-week">
              {week.map((day) => (
                <div
                  key={day.date}
                  className="mentor-analytics-heatmap-cell"
                  style={{ backgroundColor: getColor(day.mins) }}
                  title={`${day.date}: ${fmtMinutes(day.mins)}`}
                />
              ))}
            </div>
          ))}
        </div>
        <div className="mentor-analytics-heatmap-legend">
          <span className="mentor-analytics-heatmap-legend-label">少</span>
          <div className="mentor-analytics-heatmap-legend-cell" style={{ background: '#f1f5f9' }} />
          <div className="mentor-analytics-heatmap-legend-cell" style={{ background: '#dcfce7' }} />
          <div className="mentor-analytics-heatmap-legend-cell" style={{ background: '#86efac' }} />
          <div className="mentor-analytics-heatmap-legend-cell" style={{ background: '#4ade80' }} />
          <div className="mentor-analytics-heatmap-legend-cell" style={{ background: '#22c55e' }} />
          <span className="mentor-analytics-heatmap-legend-label">多</span>
        </div>
      </div>
    </div>
  );
}

function ScoreDistributionChart({ sessions }) {
  const scoreDistribution = useMemo(() => {
    const distribution = { '0-59': 0, '60-69': 0, '70-79': 0, '80-89': 0, '90-100': 0 };
    let total = 0;
    let sum = 0;
    
    for (const s of sessions) {
      if (Number(s.eval_type) === 2 && s.score != null && s.score !== '') {
        const score = Number(s.score);
        sum += score;
        if (score < 60) distribution['0-59']++;
        else if (score < 70) distribution['60-69']++;
        else if (score < 80) distribution['70-79']++;
        else if (score < 90) distribution['80-89']++;
        else distribution['90-100']++;
        total++;
      }
    }
    
    const avg = total > 0 ? Math.round(sum / total) : 0;
    
    return { distribution, total, avg };
  }, [sessions]);

  const maxCount = Math.max(...Object.values(scoreDistribution.distribution), 1);

  return (
    <div className="mentor-analytics-panel mentor-analytics-panel-distribution">
      <div className="mentor-analytics-panel-header">
        <h3 className="mentor-analytics-panel-title">分数分布</h3>
        <span className="mentor-analytics-panel-subtitle">平均分: {scoreDistribution.avg}</span>
      </div>
      <div className="mentor-analytics-distribution-content">
        <div className="mentor-analytics-distribution-bars">
          {Object.entries(scoreDistribution.distribution).map(([range, count]) => {
            const height = (count / maxCount) * 100;
            let color = '#6366f1';
            if (range === '0-59') color = '#ef4444';
            else if (range === '60-69') color = '#f59e0b';
            else if (range === '90-100') color = '#10b981';
            
            return (
              <div key={range} className="mentor-analytics-distribution-bar-item">
                <div className="mentor-analytics-distribution-bar-count">{count}</div>
                <div className="mentor-analytics-distribution-bar-track">
                  <div 
                    className="mentor-analytics-distribution-bar-fill" 
                    style={{ height: `${height}%`, background: color }} 
                  />
                </div>
                <div className="mentor-analytics-distribution-bar-label">{range}</div>
              </div>
            );
          })}
        </div>
        <div className="mentor-analytics-distribution-stats">
          <div className="mentor-analytics-distribution-stat">
            <span className="mentor-analytics-distribution-stat-label">总评分数</span>
            <span className="mentor-analytics-distribution-stat-value">{scoreDistribution.total}</span>
          </div>
          <div className="mentor-analytics-distribution-stat">
            <span className="mentor-analytics-distribution-stat-label">平均分</span>
            <span className="mentor-analytics-distribution-stat-value" style={{ color: scoreDistribution.avg >= 80 ? '#10b981' : scoreDistribution.avg >= 60 ? '#f59e0b' : '#ef4444' }}>
              {scoreDistribution.avg}
            </span>
          </div>
          <div className="mentor-analytics-distribution-stat">
            <span className="mentor-analytics-distribution-stat-label">及格率</span>
            <span className="mentor-analytics-distribution-stat-value">
              {Math.round((1 - scoreDistribution.distribution['0-59'] / scoreDistribution.total) * 100)}%
            </span>
          </div>
        </div>
      </div>
    </div>
  );
}

function EfficiencyTrendChart({ sessions }) {
  const efficiencyData = useMemo(() => {
    const byDate = {};
    for (const s of sessions) {
      const date = s.date;
      byDate[date] = byDate[date] || { mins: 0, scoreSum: 0, scoreCount: 0 };
      byDate[date].mins += s.duration_minutes || 0;
      if (Number(s.eval_type) === 2 && s.score != null && s.score !== '') {
        byDate[date].scoreSum += Number(s.score);
        byDate[date].scoreCount++;
      }
    }
    
    return Object.entries(byDate)
      .map(([date, data]) => ({
        date,
        mins: data.mins,
        avgScore: data.scoreCount > 0 ? Math.round(data.scoreSum / data.scoreCount) : null,
      }))
      .sort((a, b) => new Date(a.date) - new Date(b.date))
      .slice(-14);
  }, [sessions]);

  if (efficiencyData.length === 0) {
    return (
      <div className="mentor-analytics-panel mentor-analytics-panel-efficiency">
        <div className="mentor-analytics-panel-header">
          <h3 className="mentor-analytics-panel-title">学习效率趋势</h3>
        </div>
        <div className="mentor-empty-state">暂无数据</div>
      </div>
    );
  }

  const maxMins = Math.max(...efficiencyData.map(d => d.mins), 1);
  const avgScore = efficiencyData.filter(d => d.avgScore !== null).length > 0
    ? Math.round(efficiencyData.filter(d => d.avgScore !== null).reduce((sum, d) => sum + d.avgScore, 0) / efficiencyData.filter(d => d.avgScore !== null).length)
    : 0;
  const padding = 50;
  const height = 280;
  const width = 1200;

  return (
    <div className="mentor-analytics-panel mentor-analytics-panel-full mentor-analytics-panel-efficiency">
      <div className="mentor-analytics-panel-header">
        <h3 className="mentor-analytics-panel-title">学习效率趋势</h3>
        <span className="mentor-analytics-panel-subtitle">最近14天 · 时长与分数对比</span>
      </div>
      <div className="mentor-analytics-efficiency-wrapper">
        <svg viewBox={`0 0 ${width} ${height}`} className="mentor-analytics-efficiency-svg" preserveAspectRatio="xMidYMid meet">
          {[0, 25, 50, 75, 100].map(score => {
            const y = padding + ((100 - score) / 100) * (height - padding * 2);
            return (
              <g key={score}>
                <line
                  x1={padding}
                  y1={y}
                  x2={width - padding}
                  y2={y}
                  stroke="#e2e8f0"
                  strokeWidth="1"
                />
                <text
                  x={padding - 12}
                  y={y + 4}
                  textAnchor="end"
                  fontSize="10"
                  fill="#64748b"
                >
                  {score}
                </text>
              </g>
            );
          })}
          {avgScore > 0 && (
            <line
              x1={padding}
              y1={padding + ((100 - avgScore) / 100) * (height - padding * 2)}
              x2={width - padding}
              y2={padding + ((100 - avgScore) / 100) * (height - padding * 2)}
              stroke="#f59e0b"
              strokeWidth="2"
              strokeDasharray="8 4"
            />
          )}
          {efficiencyData.map((d, i) => {
            const x = padding + (i / (efficiencyData.length - 1)) * (width - padding * 2);
            const barHeight = (d.mins / maxMins) * (height - padding * 2);
            
            return (
              <g key={d.date}>
                <rect
                  x={x - 18}
                  y={height - padding - barHeight}
                  width="36"
                  height={barHeight}
                  fill="#6366f1"
                  fillOpacity="0.2"
                  stroke="#6366f1"
                  strokeWidth="1.5"
                  rx="6"
                />
                {d.avgScore !== null && (
                  <>
                    <circle
                      cx={x}
                      cy={padding + ((100 - d.avgScore) / 100) * (height - padding * 2)}
                      r="6"
                      fill="#10b981"
                    />
                    <circle
                      cx={x}
                      cy={padding + ((100 - d.avgScore) / 100) * (height - padding * 2)}
                      r="2.5"
                      fill="white"
                    />
                  </>
                )}
                <text x={x} y={height - 12} textAnchor="middle" fontSize="10" fill="#64748b">
                  {d.date.slice(5)}
                </text>
                {d.mins > 0 && (
                  <text x={x} y={height - padding - barHeight - 8} textAnchor="middle" fontSize="9" fill="#6366f1" fontWeight={500}>
                    {fmtMinutes(d.mins)}
                  </text>
                )}
                {d.avgScore !== null && (
                  <text x={x} y={padding + ((100 - d.avgScore) / 100) * (height - padding * 2) - 14} textAnchor="middle" fontSize="10" fill="#10b981" fontWeight={600}>
                    {d.avgScore}
                  </text>
                )}
              </g>
            );
          })}
        </svg>
        <div className="mentor-analytics-efficiency-legend">
          <div className="mentor-analytics-efficiency-legend-item">
            <div className="mentor-analytics-efficiency-legend-color" style={{ background: 'rgba(99, 102, 241, 0.3)', border: '1px solid #6366f1', borderRadius: '4px' }} />
            <span>学习时长</span>
          </div>
          <div className="mentor-analytics-efficiency-legend-item">
            <div className="mentor-analytics-efficiency-legend-color" style={{ background: '#10b981', borderRadius: '50%' }} />
            <span>分数</span>
          </div>
        </div>
      </div>
    </div>
  );
}

function PainPointAnalysis({ sessions }) {
  const painPoints = useMemo(() => {
    const result = [];
    const subjects = {};
    let totalMins = 0;
    let selfMins = 0;
    
    for (const s of sessions) {
      const subj = s.subject || '未分类';
      subjects[subj] = subjects[subj] || { mins: 0, scoreSum: 0, scoreCount: 0, selfMins: 0 };
      subjects[subj].mins += s.duration_minutes || 0;
      totalMins += s.duration_minutes || 0;
      
      if (Number(s.eval_type) === 2 && s.score != null && s.score !== '') {
        subjects[subj].scoreSum += Number(s.score);
        subjects[subj].scoreCount++;
      }
      
      if (s.form === '自主学习' || s.form === '自主复习' || s.form === '自主练习') {
        subjects[subj].selfMins += s.duration_minutes || 0;
        selfMins += s.duration_minutes || 0;
      }
    }
    
    const avgScore = Object.values(subjects).reduce((sum, s) => {
      if (s.scoreCount > 0) return sum + s.scoreSum / s.scoreCount;
      return sum;
    }, 0) / Object.keys(subjects).length;
    
    const selfRate = totalMins > 0 ? (selfMins / totalMins) * 100 : 0;
    const activeDays = new Set(sessions.map(s => s.date)).size;
    
    if (selfRate < 50) {
      result.push({
        title: '自主学习率偏低',
        description: `当前自主学习率为 ${Math.round(selfRate)}%，低于50%的理想水平，学生过度依赖校外辅导`,
        type: 'danger',
        metric: `${Math.round(selfRate)}%`,
        recommendations: [
          '逐步减少对校外辅导的依赖，尝试独立完成作业',
          '制定自主学习计划，每天安排30分钟自主学习时间',
          '鼓励学生主动提问，培养独立思考能力',
        ],
      });
    }
    
    if (activeDays < 10) {
      result.push({
        title: '学习频率不足',
        description: `最近 ${sessions.length > 0 ? '30天' : '一段时间'} 内仅 ${activeDays} 天有学习记录，学习不够规律`,
        type: 'warning',
        metric: `${activeDays}天`,
        recommendations: [
          '制定固定的学习时间表，保证每周至少学习5天',
          '设置每日学习提醒，养成良好的学习习惯',
        ],
      });
    }
    
    Object.entries(subjects).forEach(([name, data]) => {
      if (data.scoreCount > 0) {
        const subjAvg = data.scoreSum / data.scoreCount;
        if (subjAvg < 60) {
          result.push({
            title: `${name}分数偏低`,
            description: `${name}平均分数为 ${Math.round(subjAvg)}，低于及格线，需要重点关注`,
            type: 'danger',
            metric: `${Math.round(subjAvg)}分`,
            recommendations: [
              `分析${name}薄弱知识点，制定专项提升计划`,
              `增加${name}练习时间，每天至少30分钟`,
              `建议寻求${name}科目老师的额外辅导`,
            ],
          });
        } else if (subjAvg < avgScore - 10) {
          result.push({
            title: `${name}需要加强`,
            description: `${name}平均分数为 ${Math.round(subjAvg)}，低于整体平均水平 ${Math.round(avgScore)}`,
            type: 'warning',
            metric: `${Math.round(subjAvg)}分`,
            recommendations: [
              `关注${name}学习方法，可能需要调整学习策略`,
              `增加${name}复习时间，巩固已学知识`,
            ],
          });
        }
      }
      
      if (data.mins < 60 && totalMins > 120) {
        result.push({
          title: `${name}学习时间不足`,
          description: `${name}累计学习时间仅 ${fmtMinutes(data.mins)}，投入时间明显不足`,
          type: 'warning',
          metric: `${fmtMinutes(data.mins)}`,
          recommendations: [
            `增加${name}学习投入，每周至少安排2小时`,
            `制定${name}学习计划，确保规律学习`,
          ],
        });
      }
    });
    
    const getPriority = (type) => {
      if (type === 'danger') return 3;
      if (type === 'warning') return 2;
      return 1;
    };
    
    return result.sort((a, b) => getPriority(b.type) - getPriority(a.type));
  }, [sessions]);

  return (
    <div className="mentor-analytics-panel mentor-analytics-panel-full mentor-analytics-panel-pain">
      <div className="mentor-analytics-panel-header">
        <h3 className="mentor-analytics-panel-title">痛点诊断与建议</h3>
        <span className="mentor-analytics-panel-subtitle">
          {painPoints.length > 0 ? `发现 ${painPoints.length} 个问题` : '学生学习状态良好'}
        </span>
      </div>
      <div className="mentor-analytics-pain-content">
        {painPoints.length === 0 ? (
          <div className="mentor-analytics-pain-empty">
            <div className="mentor-analytics-pain-empty-icon">🎉</div>
            <div className="mentor-analytics-pain-empty-title">学生学习状态良好</div>
            <div className="mentor-analytics-pain-empty-desc">暂无明显学习痛点，继续保持！</div>
          </div>
        ) : (
          <div className="mentor-analytics-pain-list">
            {painPoints.map((point, index) => (
              <div 
                key={index} 
                className={`mentor-analytics-pain-item mentor-analytics-pain-item-${point.type}`}
              >
                <div className="mentor-analytics-pain-item-header">
                  <div className="mentor-analytics-pain-item-emoji">
                    {point.type === 'danger' ? '⚠️' : '💡'}
                  </div>
                  <div className={`mentor-analytics-pain-item-priority mentor-analytics-pain-item-priority-${point.type}`}>
                    {index + 1}
                  </div>
                  <div className="mentor-analytics-pain-item-info">
                    <div className="mentor-analytics-pain-item-title">
                      {point.title}
                      <span className={`mentor-analytics-pain-item-badge mentor-analytics-pain-item-badge-${point.type}`}>
                        {point.type === 'danger' ? '严重' : '注意'}
                      </span>
                    </div>
                    <div className="mentor-analytics-pain-item-desc">{point.description}</div>
                  </div>
                  <div className="mentor-analytics-pain-item-metric">
                    <div className={`mentor-analytics-pain-item-metric-value mentor-analytics-pain-item-metric-value-${point.type}`}>
                      {point.metric}
                    </div>
                    <div className="mentor-analytics-pain-item-metric-label">当前值</div>
                  </div>
                </div>
                <div className="mentor-analytics-pain-item-recommendations">
                  <div className="mentor-analytics-pain-item-recommendations-title">改进建议</div>
                  <ul className="mentor-analytics-pain-item-recommendations-list">
                    {point.recommendations.map((rec, i) => (
                      <li key={i} className="mentor-analytics-pain-item-recommendation">
                        <span className="mentor-analytics-pain-item-recommendation-num">{i + 1}</span>
                        <span className="mentor-analytics-pain-item-recommendation-text">{rec}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}

export default function MentorAnalyticsPage({ user, students, connections, onSelectStudent }) {
  const [selectedStudent, setSelectedStudent] = useState(null);
  const [sessions, setSessions] = useState([]);
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    if (!selectedStudent) {
      setSessions(generateFakeSessions());
      return;
    }
    
    setLoading(true);
    supabase
      .from('learning_sessions')
      .select(`
        id, session_date, duration_minutes, category, form, eval_type,
        score, course_id, course:course_id(name, subject)
      `)
      .eq('student_id', selectedStudent.id)
      .order('session_date', { ascending: false })
      .limit(2000)
      .then(({ data, error }) => {
        if (error) {
          console.error('load sessions error:', error);
          setSessions(generateFakeSessions());
        } else {
          const processed = (data || []).map((s) => ({
            ...s,
            date: String(s.session_date || '').slice(0, 10),
            subject: s.course?.subject || s.course?.name || '未分类',
          }));
          setSessions(processed.length > 0 ? processed : generateFakeSessions());
        }
        setLoading(false);
      });
  }, [selectedStudent]);

  const connectedStudents = useMemo(() => {
    return students.filter((s) => connections[s.id]?.status === 1);
  }, [students, connections]);

  return (
    <div className="mentor-analytics-page">
      <div className="mentor-analytics-header">
        <div>
          <h1 className="mentor-analytics-title">学生数据分析</h1>
          <p className="mentor-analytics-subtitle">深入分析学生学习行为，精准诊断学习痛点</p>
        </div>
        
        <div className="mentor-analytics-student-selector">
          <label>选择学生：</label>
          <select
            value={selectedStudent?.id || ''}
            onChange={(e) => {
              const id = e.target.value;
              if (!id) {
                setSelectedStudent(null);
              } else {
                const student = students.find((s) => s.id === id);
                setSelectedStudent(student || null);
              }
            }}
            className="mentor-analytics-select"
          >
            <option value="">使用演示数据</option>
            {connectedStudents.map((s) => (
              <option key={s.id} value={s.id}>
                {s.full_name || '未命名'}
              </option>
            ))}
          </select>
        </div>
      </div>

      {loading ? (
        <div className="mentor-analytics-loading">加载中…</div>
      ) : (
        <div className="mentor-analytics-content">
          <StudentOverviewCard 
            student={selectedStudent || { full_name: '演示学生', school_name: '示例学校' }} 
            sessions={sessions} 
          />

          <div className="mentor-analytics-grid-full">
            <SubjectRadarChart sessions={sessions} />
          </div>

          <div className="mentor-analytics-grid-full">
            <SubjectComparisonMatrix sessions={sessions} />
          </div>

          <div className="mentor-analytics-grid-2">
            <ScoreDistributionChart sessions={sessions} />
            <LearningHeatmap sessions={sessions} />
          </div>

          <div className="mentor-analytics-grid-full">
            <LearningBehaviorAnalysis sessions={sessions} />
          </div>

          <div className="mentor-analytics-grid-full">
            <ScoreTrendChart sessions={sessions} />
          </div>

          <div className="mentor-analytics-grid-full">
            <EfficiencyTrendChart sessions={sessions} />
          </div>

          <div className="mentor-analytics-grid-full">
            <PainPointAnalysis sessions={sessions} />
          </div>
        </div>
      )}
    </div>
  );
}