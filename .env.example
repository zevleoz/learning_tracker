# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-anon-key

# Environment
NODE_ENV=development

# Y4 综合测评外部 API（仅服务端读取：Vercel 环境变量 / 本地 .env.local）
# 切勿添加 VITE_ 前缀，切勿写入前端代码。
Y4_API_KEY=your-y4-api-key
# 可选，默认 https://report.p4learning-ark.app/api/v1
Y4_API_BASE=https://report.p4learning-ark.app/api/v1

# AI 会议佐证生成（仅服务端读取）
# 使用 OpenAI 兼容接口；阿里云百炼 / ARK / DeepSeek / Qwen / OpenAI 等均可。
# 百炼示例：
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen3.8-flash（qwen3 思考模型建议关闭思考，见 LLM_EXTRA_BODY）
LLM_API_KEY=your-llm-api-key
# 可选，默认 https://ark.cn-beijing.volces.com/api/v3
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 可选，默认 doubao-1-5-pro-32k-250115
LLM_MODEL=doubao-1-5-pro-32k-250115
# 可选，合并进请求体的厂商特有参数（JSON），如百炼 qwen3 关闭思考：
# LLM_EXTRA_BODY={"enable_thinking":false}
