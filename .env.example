# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-anon-key

# Serverless 专用（serverless 函数读不到 VITE_* 变量；本地开发由 vite 中间件自动回退到 VITE_*）
# 用于 /api/y4/* 与 /api/llm/* 的导师登录态校验，Vercel 需单独配置
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-anon-key

# Environment
NODE_ENV=development

# Y4 综合测评外部 API（仅服务端读取：Vercel 环境变量 / 本地 .env.local）
# 切勿添加 VITE_ 前缀，切勿写入前端代码。
Y4_API_KEY=your-y4-api-key
# 可选，默认 https://report.p4learning-ark.app/api/v1
# 加速建议：给 origin 加一个「灰云（DNS-only）」子域 + TLS，然后把这里指过去（实测 16ms vs 2-8s）
Y4_API_BASE=https://report.p4learning-ark.app/api/v1
# 可选：主端点全部尝试失败后自动回退的备用端点（默认即上面的 CF 域名）
Y4_API_BASE_FALLBACK=https://report.p4learning-ark.app/api/v1
# 可选：鉴权头形态。authorization（默认，Bearer）或 x-api-key。
# 上游支持 X-Api-Key 后设为 x-api-key，可让 Cloudflare 缓存规则命中（CF 默认不缓存带 Authorization 的请求）
Y4_AUTH_HEADER=authorization
# 可选：只读列表的代理侧短缓存 TTL（毫秒），0 或不设 = 关闭（默认）。
# 每个 serverless 实例各持一份，只缓存不带查询串的 200 响应；e4-protocol 永不缓存。
# 目的是让反复点选同一学生的查询不必再走一次跨境往返；建议不超过 30000。
Y4_CACHE_TTL_MS=0

# AI 会议佐证生成（仅服务端读取）
# 使用 OpenAI 兼容接口；阿里云百炼 / ARK / DeepSeek / Qwen / OpenAI 等均可。
# 百炼示例：
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen3.8-flash（qwen3 思考模型建议关闭思考，见 LLM_EXTRA_BODY）
LLM_API_KEY=your-llm-api-key
# 可选，默认 https://ark.cn-beijing.volces.com/api/v3
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 可选，默认 doubao-1-5-pro-32k-250115
LLM_MODEL=doubao-1-5-pro-32k-250115
# 可选，合并进请求体的厂商特有参数（JSON），如百炼 qwen3 关闭思考：
# LLM_EXTRA_BODY={"enable_thinking":false}

# Web Push 通知（/api/notify）。仅写变量名，真实值只放 Vercel 环境变量 / 本地 .env.local。
# 生成 VAPID 密钥对：npx web-push generate-vapid-keys
# 前端公钥（会进入前端 bundle，只能放公钥）
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
# 服务端（切勿添加 VITE_ 前缀）
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# 形如 mailto:you@example.com 或站点 https URL
VAPID_SUBJECT=mailto:you@example.com
# service role 绕过 RLS，仅服务端使用，绝不进入前端
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 调用 /api/notify 的共享密钥（x-notify-secret 头或 Authorization: Bearer）
NOTIFY_SECRET=your-notify-secret

# 邮件兜底（唯一的邮件场景：第 3 天没记录且没有可用的推送订阅时发一封；第 7 天绝不发邮件）。
# 未配置时静默跳过，不影响推送。任意 SMTP 服务商均可，已知可用的组合：
#   - 阿里云邮件推送 DirectMail（SMTP smtpdm.aliyun.com:465 SSL）：发到 QQ / 163 的到达率最好，首选
#   - 腾讯企业邮箱 Exmail（smtp.exmail.qq.com:465 SSL）
#   - Resend SMTP（smtp.resend.com:465，用户名 resend，密码是 API Key）
SMTP_HOST=smtp.example.com
SMTP_PORT=465
# 465 端口用 true；587（STARTTLS）用 false
SMTP_SECURE=true
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM="一表人才 <noreply@yourdomain>"
# 站点公开地址（无结尾斜杠）：邮件里的「记一笔」与退订链接都用它拼
APP_URL=https://your-domain.example
# 退订链接的签名密钥复用上面的 NOTIFY_SECRET
